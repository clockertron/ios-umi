+	IOLog("SWEET ADRENO: reset of the 3D core: bus halts %d/%d/%d, status %#x -> %#x -> %#x, ring at %u, CP_ME_INIT %s, "
+	    "secure mode off %s, CP fault %#x / interrupts %#x, SMMU status %#x\n", gx, client, arb, status_before,
+	    status_reset, sa_rd(sa_gpu.base + RBBM_STATUS), rptr, init ? "ok" : "NOT taken", secure ? "ok" : "NOT done",
+	    sa_rd(sa_gpu.base + CP_HW_FAULT), sa_rd(sa_gpu.base + CP_INTERRUPT_STATUS),
+	    sa_rd(sa_smmu_cb0.base + SMMU_CB_FSR));
+	return init && secure;
+}
