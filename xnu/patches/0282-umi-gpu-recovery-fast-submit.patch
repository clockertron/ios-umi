+/*
+ * (0282) Two costs of every BoMap / BoFree and of every page the submit walk visits:
+ *  - finding a table from the physical address in its parent's entry was a linear search over all tables
+ *    (300-400 once a few processes use Metal), twice per 4 KB page: now a small direct-mapped cache in front;
+ *  - sa_core_tlb_flush cleaned EVERY table page out of the CPU cache (1.4 MB at 340 tables) for each map and
+ *    unmap: now only the tables written since the last flush (sa_dirty), all of them only if the list overflowed.
+ */
+#define SA_TCACHE               4096
+static struct {
+	uint64_t phys;
+	uint64_t *table;
+} sa_tcache[SA_TCACHE];
+#define SA_DIRTY_MAX            256
+static uint64_t *sa_dirty[SA_DIRTY_MAX];
+static uint32_t sa_dirty_count;
+static bool sa_dirty_all;
+
+static void
+sa_table_dirty(uint64_t *entry)
+{
+	uint64_t *table = (uint64_t *)((uintptr_t)entry & ~(uintptr_t)4095);
+	if (sa_dirty_count != 0 && sa_dirty[sa_dirty_count - 1] == table) {
+		return;
+	}
+	if (sa_dirty_count == SA_DIRTY_MAX) {
+		sa_dirty_all = true;
+		return;
+	}
+	sa_dirty[sa_dirty_count++] = table;
+}
+
+static uint64_t *
+sa_space_table_at(struct sa_space *space, uint64_t phys)
+{
+	uint32_t slot = (uint32_t)(phys >> 12) & (SA_TCACHE - 1);
+	if (sa_tcache[slot].phys == phys && sa_tcache[slot].table != NULL) {
+		return sa_tcache[slot].table;
+	}
+	for (uint32_t i = 0; i < space->table_count; i++) {
+		if (space->table_phys[i] == phys) {
+			sa_tcache[slot].table = space->table[i];
+			sa_tcache[slot].phys = phys;
+			return space->table[i];
+		}
+	}
+	return NULL;
+}
+
 static uint64_t *
 sa_space_table(struct sa_space *space)
 {
 	static vm_offset_t spare;
 	static unsigned spare_left;
 	if (space->table_count == SA_TABLES_MAX) {
+		printf("SWEET ADRENO: %s has no more page-table slots (%u)\n", space->name, (unsigned)SA_TABLES_MAX);
 		return NULL;
 	}
 	if (spare_left == 0) {
 		if ((spare = sa_alloc(PAGE_SIZE)) == 0) {
+			printf("SWEET ADRENO: %s cannot allocate a page-table page (at %u tables)\n", space->name,
+			    space->table_count);
 			return NULL;
 		}
 		spare_left = PAGE_SIZE / 4096;
@@ -1029,20 +1090,34 @@ static uint64_t *
 sa_space_next(struct sa_space *space, uint64_t *entry)
 {
 	if (*entry & 1) {
-		for (uint32_t i = 0; i < space->table_count; i++) {
-			if (space->table_phys[i] == (*entry & PTE_ADDRESS)) {
-				return space->table[i];
-			}
-		}
-		return NULL;
+		return sa_space_table_at(space, *entry & PTE_ADDRESS);
 	}
 	uint64_t *table = sa_space_table(space);
 	if (table != NULL) {
 		*entry = sa_phys((vm_offset_t)table) | PTE_TABLE;
+		sa_table_dirty(table);          /* its zeroes must be in memory before the SMMU can walk into it */
+		sa_table_dirty(entry);
 	}
 	return table;
 }
 
+/* The last-level entry for `address` if its tables exist: nothing is made (unmaps, lookups). */
+static uint64_t *
+sa_space_find(struct sa_space *space, uint64_t address)
+{
+	if (address >> 39 || space->table_count == 0) {
+		return NULL;
+	}
+	uint64_t *table = space->table[0];
+	for (int shift = 30; shift > 12; shift -= 9) {
+		uint64_t entry = table[address >> shift & 0x1ff];
+		if ((entry & 3) != PTE_TABLE || (table = sa_space_table_at(space, entry & PTE_ADDRESS)) == NULL) {
+			return NULL;
+		}
+	}
+	return &table[address >> 12 & 0x1ff];
+}
