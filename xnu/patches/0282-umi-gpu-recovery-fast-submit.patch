+	uint32_t rptr = sa_rd(sa_gpu.base + CP_RB_RPTR) % RING_WORDS;
+	sa_ring_at = sa_ring_sent = rptr;
+	sa_wr(sa_gpu.base + CP_RB_WPTR, rptr);
+	sa_wr(sa_gpu.base + CP_SQE_CNTL, 1);
+	delay_for_interval(2, NSEC_PER_MSEC);
+	sa_ring_packet(CP_ME_INIT, 8);
+	sa_ring(0x0000002f);
+	sa_ring(0x00000003);
+	sa_ring(0x20000000);
+	sa_ring(0);
+	sa_ring(0);
+	sa_ring(0);
+	sa_ring(0);
+	sa_ring(0);
