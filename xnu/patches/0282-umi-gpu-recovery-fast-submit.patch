+static void
+sa_core_hwcg(void)
+{
+	if (sa_hwcg_want == ~0u) {
+		sa_hwcg_want = 0;
+		(void)PE_parse_boot_argn("sweetgpuhwcg", &sa_hwcg_want, sizeof(sa_hwcg_want));
+	}
+	if (!sa_hwcg_want || sa_rd(sa_gpu.base + RBBM_CLOCK_CNTL) == RBBM_CLOCK_CNTL_ON_A650) {
+		return;
+	}
+	sa_need(&sa_gmu);
+	uint32_t sp = sa_rd(sa_gmu.base + GMU_GX_SPTPRAC_CLOCK_CONTROL);
+	sa_wr(sa_gmu.base + GMU_GX_SPTPRAC_CLOCK_CONTROL, sp & ~1u);          /* SP clock off while its gating is set */
+	for (unsigned i = 0; i < sizeof(sa_a650_hwcg) / sizeof(sa_a650_hwcg[0]); i++) {
+		sa_wr(sa_gpu.base + GPU_WORD(sa_a650_hwcg[i].reg), sa_a650_hwcg[i].value);
+	}
+	sa_wr(sa_gmu.base + GMU_GX_SPTPRAC_CLOCK_CONTROL, (sp & ~1u) | 1u);
+	sa_wr(sa_gpu.base + RBBM_CLOCK_CNTL, RBBM_CLOCK_CNTL_ON_A650);
+	printf("SWEET GPU: hardware clock gating on (sweetgpuhwcg=1): rbbm_clock_cntl %#x, sptprac clock control %#x -> %#x\n",
+	    sa_rd(sa_gpu.base + RBBM_CLOCK_CNTL), sp, sa_rd(sa_gmu.base + GMU_GX_SPTPRAC_CLOCK_CONTROL));
+}
