+/*
+ * (0282) A hung core is reset and goes on, instead of the screen flipping between two frames for good.
+ *
+ * What the hang is (umi-0273e.log, two boots): the SMMU reports a read translation fault of context 0 on a junk
+ * address (0, 0xed04100), CP_INTERRUPT_STATUS shows an opcode error at the same submit, and from then on the
+ * command processor stays busy inside one indirect buffer, the fence word stands still and every later
+ * submission queues behind it. Nothing cleared it: clients' waits timed out, Turnip called its device lost,
+ * backboardd kept presenting its two stale drawables. Linux recovers from this (a6xx_recover: halt the SQE,
+ * power-cycle the core, hw_init again, go on with the ring); nothing here did.
+ *
+ * A watchdog thread looks every 250 ms. With work pending, the core's progress is the fence word, the ring
+ * read position and the two indirect-buffer positions; when none of them moves for sweetgpuhang ms (default
+ * 1500, 0 = no watchdog) the core is hung. Recovery, under the service lock: SQE halted (CP_SQE_CNTL 3), the
+ * bus drained (Linux a6xx_bus_clear_pending_transactions), RBBM_SW_RESET_CMD pulsed (a6xx_gpu_sw_reset - the
+ * GMU, its votes and the zap shader in TrustZone are not touched), the SMMU fault cleared, step 20's registers
+ * written again, the ring emptied at the position the core reports, SQE started, CP_ME_INIT, CP_SET_SECURE_MODE
+ * 0, fence interrupts on again. Every submission that was pending is DROPPED and its fence signalled: the
+ * clients lose those frames' drawing (one bad frame) and go on; they are not told "faulted", because Turnip
+ * answers that with VK_ERROR_DEVICE_LOST, which ends the compositor's device.
+ * sweetgpuhangtest=N: N seconds after the steps, the watchdog submits an indirect buffer at an unmapped address
+ * once - the same read fault - to see the recovery work.
+ */
+#define RBBM_GBIF_HALT_ACK      GPU_WORD(0x0017)
+#define RBBM_SW_RESET_CMD       GPU_WORD(0x0043)
+#define GBIF_HALT_ACK           (4 * 0x46)      /* in sa_gbif (0x3c46) */
+
+static uint32_t sa_hang_ms = 1500;
+
+/* The ring has been read to the end and the core is idle, within ms. */
+static bool
+sa_ring_idle(uint32_t ms)
+{
+	for (uint32_t i = 0; i < ms * 10; i++) {
+		if (sa_rd(sa_gpu.base + CP_RB_RPTR) == sa_ring_sent &&
+		    !(sa_rd(sa_gpu.base + RBBM_STATUS) & RBBM_STATUS_GPU_BUSY)) {
+			return true;
+		}
+		delay_for_interval(100, NSEC_PER_USEC);
+	}
+	return false;
+}
+
+/* Context 0's fault, if any: logged (the first 16) and cleared. True when there was one. */
+static bool
+sa_smmu_fault_take(const char *when)
+{
+	uint32_t fsr = sa_rd(sa_smmu_cb0.base + SMMU_CB_FSR);
+	if ((fsr & SMMU_FSR_ALL) == 0) {
+		return false;
+	}
+	uint64_t far = (uint64_t)sa_rd(sa_smmu_cb0.base + SMMU_CB_FAR + 4) << 32 | sa_rd(sa_smmu_cb0.base + SMMU_CB_FAR);
+	uint32_t syn = sa_rd(sa_smmu_cb0.base + SMMU_CB_FSYNR0);
+	sa_wr(sa_smmu_cb0.base + SMMU_CB_FSR, fsr);
+	if (sa_smmu_faults++ < 16) {
+		IOLog("SWEET ADRENO: SMMU fault of the 3D core (%s): status %#x, address %#llx, syndrome %#x (%s, level %u); "
+		    "fence %u done of %u, ring read %u of %u, CP interrupts %#x [fault %u]\n", when, fsr,
+		    (unsigned long long)far, syn, (syn & 0x10) ? "write" : "read", syn & 3, sa_fence_read(), sa_fence_seqno,
+		    sa_rd(sa_gpu.base + CP_RB_RPTR), sa_ring_sent, sa_rd(sa_gpu.base + CP_INTERRUPT_STATUS), sa_smmu_faults);
