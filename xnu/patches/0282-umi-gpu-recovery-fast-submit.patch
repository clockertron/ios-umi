+/* The core is hung at fence word `done`: reset it, drop what was pending, wake the waiters. */
+static void
+sa_recover(uint32_t done, const char *why)
+{
+	sa_service_take_lock();
+	uint32_t now_done = sa_fence_read(), newest = sa_fence_seqno;
+	if (now_done != done || (int32_t)(now_done - newest) >= 0) {
+		sa_service_drop_lock();         /* it moved after all */
+		return;
+	}
+	IOLog("SWEET ADRENO: THE 3D CORE IS HUNG (%s): fence %u of %u, ring read %u of %u, IB1 %#x%08x left %u, IB2 "
+	    "%#x%08x left %u, status %#x, interrupts %#x, CP interrupts %#x; recovery %u\n", why, now_done, newest,
+	    sa_rd(sa_gpu.base + CP_RB_RPTR), sa_ring_sent, sa_rd(sa_gpu.base + CP_IB1_BASE + 4),
+	    sa_rd(sa_gpu.base + CP_IB1_BASE), sa_rd(sa_gpu.base + CP_IB1_REM_SIZE), sa_rd(sa_gpu.base + CP_IB2_BASE + 4),
+	    sa_rd(sa_gpu.base + CP_IB2_BASE), sa_rd(sa_gpu.base + CP_IB2_REM_SIZE), sa_rd(sa_gpu.base + RBBM_STATUS),
+	    sa_rd(sa_gpu.base + RBBM_INT_0_STATUS), sa_rd(sa_gpu.base + CP_INTERRUPT_STATUS), sa_recoveries + 1);
+	bool ok = sa_core_reset();
+	if (!ok) {
+		ok = sa_core_reset();           /* once more before giving up on this round */
+	}
+	sa_recoveries++;
+	sa_core_dead = !ok;
+	if (!ok) {
+		sa_recover_failures++;
+	}
+	/* every pending submission is gone with the reset: its fence counts as signalled */
+	volatile uint32_t *fence = (volatile uint32_t *)(sa_core_scratch.memory + (CORE_FENCE_ADDRESS - CORE_SCRATCH_ADDRESS));
+	sa_recover_dropped += newest - now_done;
+	*fence = newest;
+	flush_dcache64((addr64_t)(vm_offset_t)fence, 64, FALSE);
+	sa_hang_fence = ~0u;
+	IOLog("SWEET ADRENO: recovery %u %s: %u submission(s) dropped (fences %u..%u signalled); %u recoveries, %u failed, "
+	    "%u dropped since boot\n", sa_recoveries, ok ? "done, the core runs again" : "FAILED, the core does not answer",
+	    newest - now_done, now_done + 1, newest, sa_recoveries, sa_recover_failures, sa_recover_dropped);
+	sa_service_drop_lock();
+	thread_wakeup((event_t)&sa_fence_irq);
+}
