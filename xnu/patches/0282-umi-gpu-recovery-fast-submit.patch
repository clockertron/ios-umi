+	sa_wr(sa_gbif.base + GBIF_HALT, 0);
+	sa_wr(sa_gpu.base + RBBM_SW_RESET_CMD, 1);
+	(void)sa_rd(sa_gpu.base + RBBM_SW_RESET_CMD);
+	delay_for_interval(200, NSEC_PER_USEC);
+	sa_wr(sa_gpu.base + RBBM_SW_RESET_CMD, 0);
+	(void)sa_rd(sa_gpu.base + RBBM_SW_RESET_CMD);
+	delay_for_interval(200, NSEC_PER_USEC);
+	uint32_t status_reset = sa_rd(sa_gpu.base + RBBM_STATUS);
