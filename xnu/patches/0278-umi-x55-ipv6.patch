+/* IPv6 on pdp_ip0: attach (as configd's SIOCPROTOATTACH_IN6), link-local, then the session's address / prefix */
+static void
+pd_configure6(void)
+{
+	socket_t so = NULL;
+	errno_t e = sock_socket(PF_INET6, SOCK_DGRAM, 0, NULL, NULL, &so), e1 = 0, e2 = 0, e3 = 0;
+	if (e == 0) {
+		struct in6_aliasreq_64 r;
+		bzero(&r, sizeof(r));
+		snprintf(r.ifra_name, sizeof(r.ifra_name), "pdp_ip0");
+		e1 = sock_ioctl(so, SIOCPROTOATTACH_IN6_64, &r);
+		bzero(&r, sizeof(r));
+		snprintf(r.ifra_name, sizeof(r.ifra_name), "pdp_ip0");
+		e2 = sock_ioctl(so, SIOCLL_START_64, &r);
+		bzero(&r, sizeof(r));
+		snprintf(r.ifra_name, sizeof(r.ifra_name), "pdp_ip0");
+		r.ifra_addr.sin6_len = sizeof(r.ifra_addr);
+		r.ifra_addr.sin6_family = AF_INET6;
+		memcpy(&r.ifra_addr.sin6_addr, mdd6.addr, 16);
+		r.ifra_prefixmask.sin6_len = sizeof(r.ifra_prefixmask);
+		r.ifra_prefixmask.sin6_family = AF_INET6;
+		for (unsigned i = 0; i < mdd6.plen && i < 128; ++i) {
+			r.ifra_prefixmask.sin6_addr.s6_addr[i / 8] |= (uint8_t)(0x80u >> (i % 8));
+		}
+		r.ifra_lifetime.ia6t_vltime = 0xffffffffu;      /* ND6_INFINITE_LIFETIME */
+		r.ifra_lifetime.ia6t_pltime = 0xffffffffu;      /* ND6_INFINITE_LIFETIME */
+		e3 = sock_ioctl(so, SIOCAIFADDR_IN6_64, &r);
+		sock_close(so);
+	}
+	pd.v6 = e == 0 && e3 == 0;
+	printf("SWEET MDM: DATA6: pdp_ip0 IPv6: attach %d, link-local %d, address /%u %d\n", e1, e2, mdd6.plen, e3);
+}
+
+/*
+ * The stack's Neighbor Solicitations on pdp_ip0 (cellular needs a neighbor cache in XNU, but nothing on the other side
+ * answers them): not sent to the modem; one with a source address is answered here with a Neighbor Advertisement for
+ * its target (router, solicited, override; no link-layer option: pdp_ip0 has no link address). DAD's (source ::) get
+ * no answer, so the address stays ours. True when the packet was one.
+ */
+static bool
+pd_ns(const uint8_t *p, unsigned n)
+{
+	if (n < 40 + 24 || (p[0] >> 4) != 6 || p[6] != 58 || p[40] != ND_NEIGHBOR_SOLICIT) {
+		return false;
+	}
+	static const uint8_t zero[16];
+	if (memcmp(p + 8, zero, 16) == 0) {
+		return true;                    /* DAD */
+	}
+	uint8_t a[40 + 24];
+	bzero(a, sizeof(a));
+	a[0] = 0x60;
+	a[5] = 24;                              /* payload length */
+	a[6] = 58;
+	a[7] = 255;
+	memcpy(a + 8, p + 48, 16);              /* from the target */
+	memcpy(a + 24, p + 8, 16);              /* to the asker */
+	a[40] = ND_NEIGHBOR_ADVERT;
+	a[44] = 0xe0;                           /* router, solicited, override */
+	memcpy(a + 48, p + 48, 16);
+	/* ICMPv6 checksum over the pseudo-header */
+	uint32_t sum = 0;
+	for (unsigned i = 8; i < 40; i += 2) {
+		sum += (uint32_t)(a[i] << 8 | a[i + 1]);
+	}
+	sum += 24 + 58;
+	for (unsigned i = 40; i < 64; i += 2) {
+		sum += (uint32_t)(a[i] << 8 | a[i + 1]);
+	}
+	while (sum >> 16) {
+		sum = (sum & 0xffff) + (sum >> 16);
+	}
+	uint16_t c = (uint16_t)~sum;
+	a[42] = (uint8_t)(c >> 8);
+	a[43] = (uint8_t)c;
+	pd.na++;
+	pd_input(a, sizeof(a));
+	return true;
+}
