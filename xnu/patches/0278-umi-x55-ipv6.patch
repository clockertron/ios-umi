+/*
+ * ---- mobile data, IPv6 (0278): a second WDS client (our QRTR port MX_QMI6_PORT) on QMAP mux 2 of the same data port,
+ * family 6 (the OnePlus 8 Pro port's order): Bind Mux Data Port (mux 2) -> Set IP Family 6 -> Start Network (0x19 = 6)
+ * -> Get Current Settings: 0x25 address + prefix length (17 bytes), 0x26 gateway (17), 0x27 / 0x28 DNS (16), 0x29 MTU.
+ * Started once the IPv4 session is up; a refused call is logged and tried again at most twice (60 s apart).
+ */
+static struct {
+	unsigned step, at, tries;
+	bool up;
+	uint8_t addr[16], gw[16], dns1[16], dns2[16];
+	unsigned plen;
+	uint32_t handle, mtu;
+	char a[48], g[48], d1[48], d2[48], p6[8];
+} mdd6;
+
+static void
+mx_data6_step(unsigned t_ms)
+{
+	if (!mdd.up || mdd6.up || (mdd6.step & 1) || t_ms < mdd6.at || mdd6.tries >= 3) {
+		return;
+	}
+	uint8_t t[32];
+	unsigned k = 0;
+	mdd6.at = t_ms + 30000;
+	switch (mdd6.step) {
+	case 0:
+		mdd6.tries++;
+		t[k++] = 0x10; t[k++] = 8; t[k++] = 0;
+		t[k++] = 3; t[k++] = 0; t[k++] = 0; t[k++] = 0; t[k++] = 4; t[k++] = 0; t[k++] = 0; t[k++] = 0;
+		mx_put8(t, &k, 0x11, 2);                /* mux id 2 */
+		printf("SWEET MDM: DATA6: WDS (second client) bind mux data port (mux 2), try %u\n", mdd6.tries);
+		mx_qmi_req_from(MX_QMI6_PORT, 0x01, 0xa2, t, (uint16_t)k);
+		break;
+	case 2:
+		mx_put8(t, &k, 0x01, 6);
+		mx_qmi_req_from(MX_QMI6_PORT, 0x01, 0x4d, t, (uint16_t)k);
+		break;
+	case 4:
+		mx_put8(t, &k, 0x19, 6);
+		printf("SWEET MDM: DATA6: WDS start network interface (IPv6)\n");
+		mx_qmi_req_from(MX_QMI6_PORT, 0x01, 0x20, t, (uint16_t)k);
+		break;
+	case 6:
+		mx_put32(t, &k, 0x10, 0xa310);
+		mx_qmi_req_from(MX_QMI6_PORT, 0x01, 0x2d, t, (uint16_t)k);
+		break;
+	default:
+		return;
+	}
+	mdd6.step++;
+}
+
+static void
+mx_data6_rx(const uint8_t *m, uint32_t len)
+{
+	if (len < 7) {
+		return;
+	}
+	unsigned type = m[0], msg = m[3] | m[4] << 8;
+	uint16_t tl = 0;
+	const uint8_t *r = mx_tlv(m, len, 0x02, &tl), *v;
+	unsigned res = r && tl >= 4 ? (unsigned)(r[0] | r[1] << 8) : 0xffff;
+	unsigned err = r && tl >= 4 ? (unsigned)(r[2] | r[3] << 8) : 0;
+	if (type != 2) {
+		printf("SWEET MDM: DATA6: WDS message %#x (type %u)\n", msg, type);
+		return;
+	}
+	unsigned want = mdd6.step;
+	if (!((msg == 0xa2 && want == 1) || (msg == 0x4d && want == 3) || (msg == 0x20 && want == 5) ||
+	    (msg == 0x2d && want == 7))) {
+		printf("SWEET MDM: DATA6: WDS %#x -> result %u error %u (not awaited)\n", msg, res, err);
+		return;
+	}
+	printf("SWEET MDM: DATA6: WDS %#x -> result %u error %u\n", msg, res, err);
+	if (res != 0) {
+		if (msg == 0x20) {
+			if ((v = mx_tlv(m, len, 0x10, &tl)) != NULL && tl >= 2) {
+				printf("SWEET MDM: DATA6: call end reason %u\n", v[0] | v[1] << 8);
+			}
+			if ((v = mx_tlv(m, len, 0x11, &tl)) != NULL && tl >= 4) {
+				printf("SWEET MDM: DATA6: verbose call end reason type %u reason %u\n", v[0] | v[1] << 8, v[2] | v[3] << 8);
+			}
+		}
+		mdd6.step = 0;
+		mdd6.at += 30000;               /* 60 s */
+		return;
+	}
+	if (msg == 0x20 && (v = mx_tlv(m, len, 0x01, &tl)) != NULL && tl >= 4) {
+		mdd6.handle = (uint32_t)v[0] | (uint32_t)v[1] << 8 | (uint32_t)v[2] << 16 | (uint32_t)v[3] << 24;
+		printf("SWEET MDM: DATA6: IPv6 session started (handle %#x)\n", mdd6.handle);
+	}
+	if (msg == 0x2d) {
+		if ((v = mx_tlv(m, len, 0x25, &tl)) != NULL && tl >= 17) {
+			memcpy(mdd6.addr, v, 16);
+			mdd6.plen = v[16];
+		}
+		if ((v = mx_tlv(m, len, 0x26, &tl)) != NULL && tl >= 16) {
+			memcpy(mdd6.gw, v, 16);
+		}
+		if ((v = mx_tlv(m, len, 0x27, &tl)) != NULL && tl >= 16) {
+			memcpy(mdd6.dns1, v, 16);
+		}
+		if ((v = mx_tlv(m, len, 0x28, &tl)) != NULL && tl >= 16) {
+			memcpy(mdd6.dns2, v, 16);
+		}
+		if ((v = mx_tlv(m, len, 0x29, &tl)) != NULL && tl >= 4) {
+			mdd6.mtu = (uint32_t)v[0] | (uint32_t)v[1] << 8 | (uint32_t)v[2] << 16 | (uint32_t)v[3] << 24;
+		}
+		inet_ntop(AF_INET6, mdd6.addr, mdd6.a, sizeof(mdd6.a));
+		inet_ntop(AF_INET6, mdd6.gw, mdd6.g, sizeof(mdd6.g));
+		inet_ntop(AF_INET6, mdd6.dns1, mdd6.d1, sizeof(mdd6.d1));
+		inet_ntop(AF_INET6, mdd6.dns2, mdd6.d2, sizeof(mdd6.d2));
+		snprintf(mdd6.p6, sizeof(mdd6.p6), "%u", mdd6.plen);
+		printf("SWEET MDM: DATA6: UP: /%u, mtu %u (addresses in kern.sweet_cell_data)\n", mdd6.plen, mdd6.mtu);
+		mdd6.up = mdd6.plen > 0 && mdd6.plen <= 128;
+	}
+	mdd6.step++;
+	mdd6.at = 0;
+}
+
